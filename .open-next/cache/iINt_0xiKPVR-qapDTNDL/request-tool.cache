5 rounded-full border px-3 py-2 font-semibold whitespace-nowrap transition 2xl:gap-2 2xl:px-4 border-transparent text-slate-300 hover:border-white/10 hover:bg-white/5 hover:text-white\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" class=\"h-4 w-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 9v6h4l5 4V5L9 9z\"></path><path d=\"M18 9a4 4 0 0 1 0 6\"></path></svg>Audio</button><button type=\"button\" class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-2 font-semibold whitespace-nowrap transition 2xl:gap-2 2xl:px-4 border-transparent text-slate-300 hover:border-white/10 hover:bg-white/5 hover:text-white\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" class=\"h-4 w-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3v4\"></path><path d=\"M12 17v4\"></path><path d=\"M3 12h4\"></path><path d=\"M17 12h4\"></path><path d=\"m6 6 2.5 2.5\"></path><path d=\"m15.5 15.5 2.5 2.5\"></path><path d=\"m18 6-2.5 2.5\"></path><path d=\"m8.5 15.5-2.5 2.5\"></path><circle cx=\"12\" cy=\"12\" r=\"4\"></circle></svg>AI Creator</button><button type=\"button\" class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-2 font-semibold whitespace-nowrap transition 2xl:gap-2 2xl:px-4 border-transparent text-slate-300 hover:border-white/10 hover:bg-white/5 hover:text-white\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" class=\"h-4 w-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"7\" cy=\"8\" r=\"3\"></circle><circle cx=\"17\" cy=\"8\" r=\"3\"></circle><path d=\"M2 20a5 5 0 0 1 10 0\"></path><path d=\"M12 20a5 5 0 0 1 10 0\"></path></svg>Social Growth</button></div><div class=\"hidden shrink-0 items-center gap-8 xl:flex\"><a class=\"whitespace-nowrap text-sm font-semibold text-slate-300 transition hover:text-white\" href=\"/tools\">All Tools</a><a class=\"whitespace-nowrap text-sm font-semibold text-slate-300 transition hover:text-white\" href=\"/blog\">Blog</a><a class=\"whitespace-nowrap rounded-full border border-amber-300/30 px-4 py-2 text-sm font-semibold text-amber-200 transition hover:bg-amber-300/10\" href=\"/support\">Support Us</a><a class=\"whitespace-nowrap rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-500\" href=\"/request-tool\">Request New Tool</a></div><button type=\"button\" aria-label=\"Toggle navigation menu\" aria-expanded=\"false\" class=\"inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/10 bg-slate-900 text-white xl:hidden\"><span class=\"flex w-5 flex-col gap-1.5\"><span class=\"h-0.5 rounded-full bg-current\"></span><span class=\"h-0.5 rounded-full bg-current\"></span><span class=\"h-0.5 rounded-full bg-current\"></span></span></button></div></nav><section class=\"px-6 py-24\"><div class=\"mx-auto max-w-3xl\"><h1 class=\"mb-6 text-5xl font-black tracking-tight\">Request a Tool</h1><p class=\"mb-8 text-lg leading-8 text-slate-400\">Need a converter, editor or workflow that is not available yet? Request a new tool or suggest improvements to an existing A2ZConvertor tool.</p><form class=\"rounded-3xl border border-white/10 bg-slate-900/70 p-8\"><div class=\"grid gap-5 md:grid-cols-2\"><label class=\"block\"><span class=\"mb-2 block text-sm font-semibold text-slate-300\">Name</span><input type=\"text\" class=\"w-full rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none focus:border-blue-500\" value=\"\"/></label><label class=\"block\"><span class=\"mb-2 block text-sm font-semibold text-slate-300\">Email</span><input type=\"email\" class=\"w-full rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none focus:border-blue-500\" value=\"\"/></label><label class=\"block\"><span class=\"mb-2 block text-sm font-semibold text-slate-300\">Requested tool name<span class=\"text-blue-300\"> *</span></span><input type=\"text\" required=\"\" class=\"w-full rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none focus:border-blue-500\" value=\"\"/></label><label class=\"block\"><span class=\"mb-2 block text-sm font-semibold text-slate-300\">Tool category</span><select class=\"w-full rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none focus:border-blue-500\"><option value=\"\" selected=\"\">Select a category</option><option value=\"Image Tools\">Image Tools</option><option value=\"PDF Tools\">PDF Tools</option><option value=\"Video Tools\">Video Tools</option><option value=\"Audio Tools\">Audio Tools</option><option value=\"Text Tools\">Text Tools</option></select></label></div><label class=\"mt-5 block\"><span class=\"mb-2 block text-sm font-semibold text-slate-300\">Description <span class=\"text-blue-300\">*</span></span><textarea required=\"\" rows=\"6\" placeholder=\"Tell us what the tool should do, file formats it should support, and any workflow details.\" class=\"w-full rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none focus:border-blue-500\"></textarea></label><button type=\"submit\" class=\"mt-6 w-full rounded-xl bg-white px-6 py-3 font-semibold text-black\">Open Email Request</button><p class=\"mt-4 text-sm text-slate-500\">This opens your email app with a prefilled message. A2ZConvertor does not save requests to a database yet.</p></form></div></section><section class=\"px-6 pb-24\"><div class=\"mx-auto max-w-6xl\"><p class=\"text-sm font-semibold uppercase text-blue-300\">Product roadmap</p><h2 class=\"mt-2 text-4xl font-black\">Vote for upcoming tools</h2><p class=\"mt-4 max-w-3xl leading-7 text-slate-400\">Tell us which ideas are most useful. Votes are saved in this browser for now. They are not global counts and are not sent to a backend.</p><div class=\"mt-8 grid gap-5 md:grid-cols-2\"><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Image Tools</p><h3 class=\"mt-2 text-2xl font-bold\">HEIC Converter</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-amber-400/30 bg-amber-400/10 text-amber-200\">Under Review</span></div><p class=\"mt-4 leading-7 text-slate-400\">Convert modern HEIC photos to widely supported JPG or PNG files.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Image Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Image Collage Maker</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-slate-500/30 bg-slate-500/10 text-slate-300\">Planned</span></div><p class=\"mt-4 leading-7 text-slate-400\">Arrange several images into a downloadable collage layout.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">PDF Tools</p><h3 class=\"mt-2 text-2xl font-bold\">PDF to Editable Word</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-amber-400/30 bg-amber-400/10 text-amber-200\">Under Review</span></div><p class=\"mt-4 leading-7 text-slate-400\">Explore an honest text-first DOCX export for suitable PDFs.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">PDF Tools</p><h3 class=\"mt-2 text-2xl font-bold\">OCR Searchable PDF</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-slate-500/30 bg-slate-500/10 text-slate-300\">Planned</span></div><p class=\"mt-4 leading-7 text-slate-400\">Recognize printed text in scanned pages and add a searchable layer.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Video Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Trim Video</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-green-400/30 bg-green-400/10 text-green-200\">Building</span></div><p class=\"mt-4 leading-7 text-slate-400\">Select a start and end time and export a shortened video.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Video Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Crop Video</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-amber-400/30 bg-amber-400/10 text-amber-200\">Under Review</span></div><p class=\"mt-4 leading-7 text-slate-400\">Visually select a video crop area and export the result.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Audio Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Audio Joiner</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-slate-500/30 bg-slate-500/10 text-slate-300\">Planned</span></div><p class=\"mt-4 leading-7 text-slate-400\">Combine multiple compatible audio files into one WAV download.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Audio Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Audio Speed Changer</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-green-400/30 bg-green-400/10 text-green-200\">Building</span></div><p class=\"mt-4 leading-7 text-slate-400\">Adjust playback speed and export processed audio in the browser.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Text Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Word and Reading Time Counter</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-slate-500/30 bg-slate-500/10 text-slate-300\">Planned</span></div><p class=\"mt-4 leading-7 text-slate-400\">Count words, characters, sentences and estimated reading time.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article><article class=\"flex min-h-64 flex-col rounded-2xl border border-white/10 bg-slate-900/70 p-6\"><div class=\"flex flex-wrap items-start justify-between gap-3\"><div><p class=\"text-xs font-semibold uppercase text-blue-300\">Text Tools</p><h3 class=\"mt-2 text-2xl font-bold\">Markdown Cleaner</h3></div><span class=\"rounded-full border px-3 py-1 text-xs font-semibold border-amber-400/30 bg-amber-400/10 text-amber-200\">Under Review</span></div><p class=\"mt-4 leading-7 text-slate-400\">Normalize pasted Markdown spacing, headings and list formatting.</p><button type=\"button\" aria-pressed=\"false\" class=\"mt-auto rounded-xl px-4 py-3 text-sm font-semibold transition bg-white text-black hover:bg-slate-200\">Vote for this tool</button></article></div></div></section><section class=\"border-y border-white/10 bg-amber-300/5 px-6 py-14\"><div class=\"mx-auto max-w-5xl\"><p class=\"text-sm font-bold uppercase text-amber-200\">Keep free tools growing</p><h2 class=\"mt-2 text-2xl font-black\">Support A2ZConvertor</h2><p class=\"mt-3 max-w-2xl leading-7 text-slate-300\">AI generations, hosting, development and new tools cost money. Your support helps us keep useful tools free and improve daily limits.</p><div class=\"mt-5 flex flex-wrap gap-3\"><a href=\"https://buymeacoffee.com/a2zconvertor\" target=\"_blank\" rel=\"noreferrer\" class=\"rounded-xl bg-amber-300 px-5 py-3 font-bold text-slate-950 hover:bg-amber-200\">Buy Me a Coffee</a><a class=\"rounded-xl border border-white/10 px-5 py-3 font-semibold text-slate-200 hover:border-amber-300/50\" href=\"/support\">Learn more</a></div></div></section><footer class=\"border-t border-white/10 px-6 py-16\"><div class=\"mx-auto mb-12 max-w-7xl\"><section class=\"rounded-2xl border border-white/10 bg-slate-900/70 p-5\"><div class=\"\"><h2 class=\"text-xl font-black\">Get new free tools and creator tips.</h2><p class=\"mt-3 max-w-2xl leading-7 text-slate-400\">Be first to know when we launch new converters, PDF tools and browser-based productivity tools.</p><form class=\"mt-5 flex gap-3 flex-col\"><label class=\"sr-only\" for=\"_R_6lfiuvb_\">Email address</label><input id=\"_R_6lfiuvb_\" type=\"email\" required=\"\" autoComplete=\"email\" placeholder=\"you@example.com\" class=\"min-w-0 flex-1 rounded-xl border border-white/10 bg-slate-950 px-4 py-3 text-white outline-none focus:border-blue-500\" name=\"email\" value=\"\"/><input type=\"hidden\" name=\"source\" value=\"a2zconvertor\"/><button type=\"submit\" class=\"rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-500\">Join by email</button></form><p class=\"mt-3 text-xs leading-5 text-slate-500\">No newsletter provider is connected yet. This opens your email app; we do not fake a stored subscription.</p></div></section></div><div class=\"mx-auto grid max-w-7xl gap-10 md:grid-cols-4\"><div><h3 class=\"mb-4 text-2xl font-black\">A2Z<span class=\"text-blue-500\">Convertor</span></h3><p class=\"text-slate-400\">Free online tools to convert, compress and edit files quickly.</p></div><div><h4 class=\"mb-4 font-bold\">Categories</h4><ul class=\"space-y-2 text-slate-400\"><li><a class=\"transition hover:text-white\" href=\"/tools\">All Tools</a></li><li><a class=\"transition hover:text-white\" href=\"/image-tools\">Image Tools</a></li><li><a class=\"transition hover:text-white\" href=\"/pdf-tools\">PDF Tools</a></li><li><a clas