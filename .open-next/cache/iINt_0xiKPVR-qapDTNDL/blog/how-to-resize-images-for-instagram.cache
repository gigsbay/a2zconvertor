{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/how-to-resize-images-for-instagram"},"segmentPaths":["/_tree","/_full","/blog/$d$slug/__PAGE__","/blog/$d$slug","/blog","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" data-theme=\"dark\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/19o6f7cg6682-.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/44q0rc0pno6br.js\"/><script src=\"/_next/static/chunks/27jktro2p5rq9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3j9pm5otqxm82.js\" async=\"\"></script><script src=\"/_next/static/chunks/07u_h6i539_wj.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-07tybozdls5zh.js\" async=\"\"></script><script src=\"/_next/static/chunks/0wo14ekga48y5.js\" async=\"\"></script><script src=\"/_next/static/chunks/3btko-qtf2ieg.js\" async=\"\"></script><script src=\"/_next/static/chunks/19o0oget1lgbk.js\" async=\"\"></script><script async=\"\" src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3170454283323014\" crossorigin=\"anonymous\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtm.js?id=GTM-MQ45H2SF\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-31